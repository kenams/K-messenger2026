{
  "name": "k-ssenger",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev:server": "npm --workspace @kssenger/server run dev",
    "test:server": "npm --workspace @kssenger/server test",
    "test:e2e": "npm --workspace @kssenger/e2e test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "release:check-static": "node scripts/release-candidate-static-gate.mjs",
    "release:check-neon-live": "node scripts/neon-live-release-readiness.mjs",
    "ship:web": "node scripts/ship-web.mjs"
  },
  "dependencies": {}
}
