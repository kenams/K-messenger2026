# Dedicated K-ssenger public endpoints only. Never put a database connection
# string, password, service role, signing key, or another project's URL here.
EXPO_PUBLIC_NEON_AUTH_URL=https://YOUR-KSSENGER-BRANCH.neonauth.REGION.aws.neon.tech/kssenger/auth
EXPO_PUBLIC_NEON_DATA_API_URL=https://YOUR-KSSENGER-BRANCH.apirest.REGION.aws.neon.tech/kssenger/rest/v1
EXPO_PUBLIC_KSSENGER_SOCKET_URL=https://YOUR-KSSENGER-REALTIME-SERVER

# Public provider identifiers used by the client-side now-playing integration.
# Spotify uses Authorization Code + PKCE: no client secret is embedded.
# Last.fm calls this value an API key, but only the separate shared secret must
# remain private. K-ssenger uses the read-only key as a public client id.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
EXPO_PUBLIC_LASTFM_CLIENT_ID=YOUR_LASTFM_READ_KEY

# Register BOTH redirect URIs in the K-ssenger Spotify developer application:
#   https://k-ssenger.expo.app/
#   kssenger://spotify-callback
